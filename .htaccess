# Skope Digital Academy - Ultra-Safe Security Shield
# -----------------------------------------------

# Disable directory listing
Options -Indexes

# Safe Rewrite (Only if mod_rewrite is enabled)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Prevent direct access to core folders
    RewriteRule ^includes/.*$ - [F,L]
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.git/.*$ - [F,L]
</IfModule>

# Security Headers (Only if mod_headers is enabled)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent access to dot files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Skope Digital Academy - Ultra-Safe Security Shield
# -----------------------------------------------

# Friendly error pages (error.php is self-contained: no database needed)
ErrorDocument 400 /error.php
ErrorDocument 401 /error.php
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 429 /error.php
ErrorDocument 500 /error.php
ErrorDocument 503 /error.php

# Disable directory listing
Options -Indexes

# Safe Rewrite (Only if mod_rewrite is enabled)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # XML sitemap for search engines
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    # Prevent direct access to core folders
    RewriteRule ^includes/.*$ - [F,L]
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.git/.*$ - [F,L]

    # ── Extensionless URLs ──────────────────────────────────────
    # 1. Old links: send browsers from page.php to page (GET/HEAD only, so
    #    form posts and payment webhooks are never redirected). Query strings carry over.
    #    folder/index.php -> folder/
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s([^?\s]*/)index\.php[?\s]
    RewriteRule (^|/)index\.php$ %2 [R=301,L,NE]
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s([^?\s]+)\.php[?\s]
    RewriteRule \.php$ %2 [R=301,L,NE]

    # Tutorial pages: learn/<tutorial>/<lesson>
    RewriteRule ^learn/([a-z0-9-]+)/?$ learn.php?c=$1 [L,QSA]
    RewriteRule ^learn/([a-z0-9-]+)/leaderboard/?$ learn.php?c=$1&view=leaderboard [L,QSA]
    RewriteRule ^learn/([a-z0-9-]+)/project/?$ learn.php?c=$1&view=project [L,QSA]
    RewriteRule ^learn/([a-z0-9-]+)/([a-z0-9-]+)/?$ learn.php?c=$1&l=$2 [L,QSA]

    # Learning Lab (non-programming skills courses): lab/<course>/<lesson>, same engine as learn.php
    RewriteRule ^lab/?$ learn.php?labhome=1 [L,QSA]
    RewriteRule ^lab/([a-z0-9-]+)/?$ learn.php?c=$1&lab=1 [L,QSA]
    RewriteRule ^lab/([a-z0-9-]+)/leaderboard/?$ learn.php?c=$1&view=leaderboard&lab=1 [L,QSA]
    RewriteRule ^lab/([a-z0-9-]+)/project/?$ learn.php?c=$1&view=project&lab=1 [L,QSA]
    RewriteRule ^lab/([a-z0-9-]+)/([a-z0-9-]+)/?$ learn.php?c=$1&l=$2&lab=1 [L,QSA]

    # 2. Clean URL -> the PHP file that serves it (internal, invisible to the browser).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Security Headers (Only if mod_headers is enabled)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "0"
    # Only send the site name to other sites, never full addresses (which can carry tokens)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # No camera / microphone / location for this site or anything embedded in it
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), magnetometer=(), gyroscope=(), payment=(self \"https://checkout.paystack.com\")"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    # Content Security Policy: HTTPS sources only, no plugins, no <base> hijack, no framing by other sites,
    # forms post only to this site or HTTPS (payment and Google). Kept broad so the code editor, video,
    # Paystack and Google sign-in keep working.
    Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https: blob: data:; worker-src 'self' blob:; media-src 'self' https: blob: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https:"
    Header always unset X-Powered-By
</IfModule>

# Docs, scripts, dumps and logs are never served
<FilesMatch "(?i)\.(md|sh|sql|log|bak|dist|lock|ini)$">
    Require all denied
</FilesMatch>

# Prevent access to dot files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# App (PWA): correct types, and always re-check the service worker and manifest so updates reach phones quickly
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest|offline\.html)$">
        Header set Cache-Control "no-cache, max-age=0"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
</IfModule>
